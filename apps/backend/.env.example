# AccountInterlockHub 백엔드 — 연동 구성 상수(MDL-022) 환경변수 키 목록.
# 값의 단일 출처는 ../../CLAUDE.env.md §연동 구성 상수 — 이 파일에는 키 이름만 두고 값은 채우지 않는다(OPS-001-04).
# 배포 시 애플리케이션 설정으로 주입한다. 런타임에 값을 바꾸는 수단은 없다(OPS-001-01) — 변경은 재배포로만 반영된다.
# 기동 시 아래 필수 상수 8종의 존재·형식을 검증하며, 하나라도 미충족이면 기동을 중단한다(PROC-901 · EX-OPS-001).
# CONSENT_NOTICE 는 선택 상수라 이 검증 대상이 아니다(아래 해당 항목 주석 참고).

# 사용자 진입 경로 — 경로 형태('/' 로 시작하는 절대 경로). 값은 CLAUDE.env.md §연동 구성 상수가 단일 출처
INTERLOCK_ENTRY_PATH=

# 연동 규약 자가진단 API 경로 — 경로 형태. 운영 값은 비공개로 취급하고 배포 시점에 새로 지정한다(SEC-003-01)
SELFCHECK_PATH=

# 수신처(서비스 B) 전달 주소 — URL 형태(http:// 또는 https:// 로 시작)
RECEIVER_DELIVERY_URL=

# 동의 항목 목록 — JSON 배열 문자열. 형식은 CLAUDE.env.md §동의 항목 값 참조
CONSENT_ITEMS=

# 동의 화면 상단 안내 문구 — 선택(미설정 시 빈 문자열 · 안내 영역 미표시). 기동 시 형식 검증 대상이 아니다(MDL-022).
# 허용 형태(최대 400자·최대 3단락·평문 — HTML 태그·링크 금지)는 상수 작성 지침이며 애플리케이션이 강제하지 않는다(EXC-DATA-08)
CONSENT_NOTICE=

# 추적 레코드 보관 기간(개월, 양의 정수) — 결과 확인 완료 시점 기산
RETENTION_MONTHS=

# 추적 레코드 생성 기산 절대 보관 상한(개월, 양의 정수)
RETENTION_MAX_MONTHS=

# 동의 증적 보존 기간(개월, 양의 정수) — 동의 일시 기산
CONSENT_PROOF_RETENTION_MONTHS=

# 연동 완료 결과에서 사용자를 되돌려 보낼 복귀 주소 — URL 형태(http:// 또는 https:// 로 시작). 기동 필수 상수
COMPLETION_REDIRECT_URL=

# 애플리케이션 기동 포트 — 선택(미설정 시 기본 3000). MDL-022 상수가 아니라 운영 설정값이다
PORT=

# ---
# 데이터베이스 접속(PostgreSQL 16 — docs/prd/devspec/database.md). MDL-022 연동 구성 상수가
# 아니라 배포 인프라 값이다. 값은 환경마다 다르며 이 파일에는 키 이름만 둔다(비밀 값 커밋 금지).
# apps/backend/src/database/migrate.ts(마이그레이션)·database.service.ts(런타임 접속)가 참조한다.

# 데이터베이스 호스트
DB_HOST=

# 데이터베이스 포트
DB_PORT=

# 데이터베이스 이름
DB_NAME=

# 접속 계정
DB_USER=

# 접속 계정 비밀번호
DB_PASSWORD=
